{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.astro", "!src/lib/api/*.d.ts", "!public"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useConst": "off",
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/site/**",
        "src/layouts/SiteLayout.astro",
        "src/layouts/TraceLayout.astro",
        "src/pages/**",
        "!src/pages/quan-ly/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": ["**/admin/**", "**/admin.css"],
                    "message": "Trang công khai không được import code hoặc CSS của app quản lý (frontend-seo.md mục 1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/admin/**",
        "src/scripts/admin/**",
        "src/layouts/AdminLayout.astro",
        "src/layouts/PrintLayout.astro",
        "src/pages/quan-ly/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": ["**/components/site/**", "**/site.css"],
                    "message": "App quản lý không được import component hoặc CSS của trang công khai (frontend-seo.md mục 1)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
