# Mẫu biến môi trường (docs/kien-truc/van-hanh.md mục 4). CHỈ giá trị giả.
# Sao thành .env.dev / .env.staging / .env.prod (không commit), quyền 600 trên VPS.

# --- Chung ---
ENVIRONMENT=dev
SITE_ADDRESS=vyc.example.com
TZ=Asia/Ho_Chi_Minh

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-50
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
SITE_ORIGIN=http://localhost:4321
# prod 172.28.0.0/24, staging 172.29.0.0/24, dev như dưới
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
IP_HASH_SALT=change-me-random-salt
MEDIA_ROOT=/data/media
MEDIA_PRIVATE_ROOT=/data/media-private
# Để trống thì tắt báo lỗi 5xx
ERROR_WEBHOOK_URL=

# --- Postgres ---
POSTGRES_DB=vyc
POSTGRES_USER=vyc
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgres://vyc:change-me-db-password@postgres:5432/vyc

# --- Astro ---
API_INTERNAL_URL=http://backend:8000
SITE_URL=http://localhost:4321
# Để trống thì tắt GTM
GTM_ID=

# --- Caddy CSP (chỉ điền khi GTM_ID có giá trị; trống thì không mở host nào) ---
CSP_GTM_SCRIPT=
CSP_GTM_CONNECT=
CSP_GTM_IMG=

# --- Staging (chỉ khi cùng VPS) ---
STAGING_ADDRESS=staging.vyc.example.com
STAGING_BASIC_USER=staging
# Hash bcrypt từ: caddy hash-password
STAGING_BASIC_HASH=change-me-bcrypt-hash

# --- Sao lưu ---
BACKUP_REMOTE=vyc-crypt:
BACKUP_KEEP=30
# Cấu hình rclone nằm ở file rclone.conf quyền 600 ngoài repo (hoặc biến RCLONE_CONFIG_<TÊN-REMOTE>_*, giá trị thật chỉ trên VPS)
ALERT_WEBHOOK_URL=

# --- Image (compose.prod.yml; deploy.sh tự đặt IMAGE_TAG, không điền ở đây) ---
# IMAGE_REPO=ghcr.io/kevindodv

# --- Giới hạn tài nguyên: mặc định là của PROD. Chỉ .env.staging đặt các giá trị sau (van-hanh.md 2.1) ---
# PG_MEM_LIMIT=384m
# PG_SHARED_BUFFERS=96MB
# BACKEND_MEM_LIMIT=384m
# WEB_CONCURRENCY=2
# FRONTEND_MEM_LIMIT=256m
# FRONTEND_HEAP_MB=160
