---
import "../components/admin/admin.css";
import { isActivePath, isCatalogPath, userLabel, visibleMenu } from "../lib/admin/menu";

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const pathname = Astro.url.pathname;
const catalogMenu = visibleMenu(user?.role);
const who = user ? userLabel(user) : null;
---
<!doctype html>
<html lang="vi" data-theme="vyc">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Quản lý Quế Văn Yên</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="navbar border-b border-base-300 bg-base-100">
      <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4">
        <a href="/quan-ly" class="text-lg font-bold text-primary">Quản lý Quế Văn Yên</a>
        {user && who && (
          <div class="flex flex-wrap items-center gap-3">
            <nav aria-label="Menu quản lý" class="flex items-center gap-2">
              {catalogMenu.length > 0 && (
                <details class="dropdown dropdown-end" data-menu="catalog">
                  <summary
                    class:list={["btn btn-sm btn-ghost", isCatalogPath(pathname) && "text-primary"]}
                  >Danh mục</summary>
                  <ul class="menu dropdown-content z-10 mt-1 w-64 rounded-box border border-base-300 bg-base-100 p-2 shadow">
                    {catalogMenu.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          class:list={[isActivePath(item.href, pathname) && "menu-active"]}
                          aria-current={isActivePath(item.href, pathname) ? "page" : undefined}
                        >{item.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </nav>
            <span class="text-sm" data-user>
              {who.name}
              {who.roleBadge && <span class="badge badge-ghost">{who.roleBadge}</span>}
            </span>
            <button type="button" class="btn btn-sm btn-ghost" data-logout>Đăng xuất</button>
          </div>
        )}
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
      <slot />
    </main>
    <script>
      import "../scripts/admin/shell";
    </script>
  </body>
</html>
