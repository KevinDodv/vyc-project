---
import Admin from "../../../layouts/Admin.astro";
import { loadProductChoices, loadSupplierChoices } from "../../../lib/admin/catalog-products/load";
import CertificateForm from "./_CertificateForm.astro";

export const prerender = false;

const [choices, sellers] = await Promise.all([
  loadProductChoices(Astro.request),
  loadSupplierChoices(Astro.request),
]);
const failed = choices.kind === "unavailable" || sellers.kind === "unavailable";
if (failed) Astro.response.status = 503;
---
<Admin title="Thêm chứng nhận">
  <h1 class="mb-4 text-2xl font-bold">Thêm chứng nhận</h1>
  {choices.kind === "ok" && sellers.kind === "ok" && (
    <CertificateForm products={choices.products} suppliers={sellers.suppliers} />
  )}
  {failed && <p role="alert" class="alert alert-error">Chưa tải được danh sách sản phẩm và người bán. Bạn thử lại sau ít phút.</p>}
</Admin>
