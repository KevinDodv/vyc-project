---
interface Props {
  heading: string;
  message: string;
}
const { heading, message } = Astro.props;
---
<section class="mx-auto max-w-xl py-16 text-center">
  <h1 class="text-2xl font-bold">{heading}</h1>
  <p class="mt-3">{message}</p>
  <a href="/" class="btn btn-primary mt-6">Về trang chủ</a>
</section>
